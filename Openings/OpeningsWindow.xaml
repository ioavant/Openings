<Window x:Class="Openings.OpeningsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Openings"
        Title="Openings"
        Width="980" Height="560" MinWidth="720" MinHeight="380"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Which models the walls / floors come from -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Walls / floors from:" FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <local:CheckDropDown x:Name="SourcesDrop" Width="380"/>
            <TextBlock Text="Openings as:" FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Center" Margin="24,0,8,0"/>
            <ComboBox x:Name="ModeCombo" Width="230" VerticalAlignment="Center"
                      ToolTip="What new openings are placed as, and what Convert turns openings into. A family takes rectangles and circles only; free shapes stay Generic Models.">
                <ComboBoxItem Content="Generic Model (DirectShape)"/>
                <ComboBoxItem Content="Family (face-based)"/>
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="ListLabel" Text="Openings" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,4"/>

        <DataGrid Grid.Row="2" x:Name="OpeningsGrid"
                  AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  GridLinesVisibility="All" HeadersVisibility="Column"
                  Background="White" RowBackground="White" AlternatingRowBackground="#F5FAFF">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Lock" Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsLocked, Mode=OneWay}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Click="LockBox_Click"
                                      ToolTip="Locked: a run over the whole view leaves it alone (a run on selected elements still updates it). Set automatically when the opening is edited, changed or deleted by hand."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ID" Binding="{Binding OpeningId}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="Host" Binding="{Binding HostType}" Width="55" IsReadOnly="True"/>
                <DataGridTextColumn Header="Shape" Binding="{Binding Shape}" Width="85" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" IsReadOnly="True"/>
                <!-- The one editable cell (wall openings): the user's own height, kept while locked, shown with * -->
                <DataGridTextColumn x:Name="BottomFromFloorColumn" Header="Bottom from floor" Binding="{Binding BottomFromFloor}" Width="115"/>
                <DataGridTextColumn Header="Host element" Binding="{Binding Host}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="Floor below" Binding="{Binding Floor}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="MEP elements" Binding="{Binding Mep}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="StatusText" FontSize="11" Foreground="#777777" Margin="0,4,0,0"/>

        <!-- Width sketch in progress (Edit Width): the user works in Revit, then Apply / Cancel here -->
        <Border Grid.Row="4" x:Name="EditBanner" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,8"
                Background="#FFF4E5" BorderBrush="#F0A040" BorderThickness="1" CornerRadius="3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EditApplyButton" Content="Apply" Padding="18,5" Margin="8,0,0,0" FontWeight="Bold"/>
                    <Button x:Name="EditCancelButton" Content="Cancel" Padding="18,5" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="EditText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/>
            </DockPanel>
        </Border>

        <UniformGrid Grid.Row="5" x:Name="ButtonRow" Columns="7" Rows="1" Margin="0,10,0,0"/>
    </Grid>
</Window>
